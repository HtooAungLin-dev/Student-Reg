@model RegistrationApp.Models.StudentFormModel
@{ ViewBag.Title = "Student Registration"; }

<h2>Student Registration</h2>

@using (Html.BeginForm("Register", "Students", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

    <div class="row"><div class="col-md-5">
        @Html.Partial("_StudentFields", Model)
        <button type="submit" class="btn btn-primary">Submit</button>
        @Html.ActionLink("View all students", "Index", null, new { @class = "btn btn-default" })
    </div></div>
}

@section Scripts { @Html.Partial("_ValidationScripts") }
